{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrous Frog SEO Spider",
  "version": "0.1.0",
  "identifier": "com.ferrousfrog.seospider",
  "build": {
    "beforeDevCommand": "bash scripts/ensure-vite-dev.sh",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "Starting Ferrous Frog",
        "url": "splash.html",
        "width": 400,
        "height": 280,
        "center": true,
        "resizable": false,
        "decorations": false
      },
      {
        "label": "main",
        "visible": false,
        "title": "Ferrous Frog SEO Spider",
        "width": 1280,
        "height": 840,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
