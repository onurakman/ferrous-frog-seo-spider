{% if section == "header" %}<!doctype html>
<html lang="{{ labels.language }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; script-src 'self'; base-uri 'none'; object-src 'none'"><title>{{ title }} · Ferrous Frog</title><link rel="stylesheet" href="report.css"><script src="report.js" defer></script></head><body><main><div class="brand"><span class="brand-mark" aria-hidden="true">F</span> FERROUS FROG <span class="brand-note">{{ labels.eyebrow }}</span></div>
{% elif section == "index" %}
<header class="hero"><p class="eyebrow">{{ labels.eyebrow }}</p><h1>{{ summary.request.title }}</h1><p class="lead">{{ labels.subtitle }}</p><div class="meta"><span>{{ labels.source }}: <strong>{{ summary.request.sourceSessionId }}</strong></span><span>{{ labels.created }}: <time>{{ summary.request.createdAt }}</time></span></div>{% if summary.partial %}<p class="notice">{{ labels.partial }}</p>{% endif %}</header>
<section class="metrics" aria-label="{{ labels.summary }}"><div class="metric"><span>{{ labels.inScope }}</span><strong>{{ summary.scopeRecords }}</strong><small>{{ summary.eligibleHtmlRecords }} {{ labels.eligible }}</small></div><div class="metric severity-error"><span>{{ labels.errors }}</span><strong>{{ errors }}</strong><small>{{ labels.findings }}</small></div><div class="metric severity-warning"><span>{{ labels.warnings }}</span><strong>{{ warnings }}</strong><small>{{ labels.findings }}</small></div><div class="metric"><span>{{ labels.infos }}</span><strong>{{ infos }}</strong><small>{{ labels.findings }}</small></div></section>
<section class="overview"><div><p class="eyebrow">{{ labels.summary }}</p><h2>{{ summary.findingCount }} {{ labels.findings }}</h2></div><p>{{ labels.overview }}</p></section>
{% if overview %}<section class="overview ai-overview"><div><p class="eyebrow">{{ labels.aiOverview }}</p><h2>{{ labels.aiExplanation }}</h2></div><div><p>{{ overview.summary }}</p><h3>{{ labels.aiPriorities }}</h3><ol>{% for findingId in overview.prioritizedFindingIds %}{% for card in cards %}{% if card.finding.id == findingId %}<li><a href="#finding-{{ card.number }}">{{ card.presentation.title }}</a></li>{% endif %}{% endfor %}{% endfor %}</ol><h3>{{ labels.aiLimitations }}</h3><p>{{ overview.limitations }}</p><p class="muted">{{ labels.aiCoverage }}: {{ overview.includedFindingCount }} / {{ overview.totalFindingCount }} · {{ labels.aiSamples }}: {{ overview.sampledEvidenceCount }}{% if overview.partialCoverage %} · {{ labels.incomplete }}{% endif %}</p></div></section>{% endif %}
{% if aiGenerationVersion %}<p class="notice">{{ labels.aiGeneration }}: {{ aiGenerationVersion }}</p>{% endif %}
{% if aiAnnotatedFindings %}<p class="notice">{{ labels.aiDisclosure }} · {{ aiAnnotatedFindings }} / {{ summary.findingCount }}</p>{% endif %}
<section class="overview measured-priorities"><h2>{% if labels.language == "tr" %}Ölçülen öncelikler{% else %}Measured priorities{% endif %}</h2><p>{% if labels.language == "tr" %}Önce hataları, sonra uyarıları inceleyin. Aşağıdaki işlemler kaydedilmiş kanıtlara dayanır ve doğrulama adımlarını içerir.{% else %}Review errors before warnings. Each action below uses captured evidence and includes a verification step.{% endif %}</p><ol>{% for card in cards %}<li><strong>{{ card.presentation.title }}</strong> — {{ card.presentation.recommendation }} <span class="muted">{{ card.presentation.verification }}</span></li>{% endfor %}</ol></section><section class="findings-section"><div class="section-heading"><h2>{{ labels.findings }}</h2><span id="finding-count" aria-live="polite">{{ summary.findingCount }}</span></div><div class="filters"><label>{{ labels.filter }}<input id="finding-search" type="search" placeholder="{{ labels.filter }}"></label><label>{{ labels.status }}<select id="severity-filter"><option value="">{{ labels.allSeverities }}</option><option value="error">{{ labels.errors }}</option><option value="warning">{{ labels.warnings }}</option><option value="info">{{ labels.infos }}</option></select></label><label>{{ labels.allTeams }}<select id="team-filter"><option value="">{{ labels.allTeams }}</option><option value="Content">{{ labels.content }}</option><option value="Engineering">{{ labels.engineering }}</option></select></label></div>
{% for card in cards %}<article class="finding-card" id="finding-{{ card.number }}" data-finding data-severity="{{ card.finding.severity }}" data-team="{{ card.finding.suggestedTeam }}"><details open><summary><span class="finding-number">{{ card.number }}</span><span class="finding-heading"><span class="eyebrow">{{ card.presentation.category }} · {{ card.presentation.team }}</span><strong>{{ card.presentation.title }}</strong></span><span class="badge severity-{{ card.finding.severity }}">{% if card.finding.severity == "error" %}{{ labels.errors }}{% elif card.finding.severity == "warning" %}{{ labels.warnings }}{% else %}{{ labels.infos }}{% endif %}</span></summary><div class="finding-body"><div class="counts"><span><b>{{ card.finding.counts.uniqueUrls }}</b> {% if card.finding.counts.targets is not none %}{{ labels.targets }}{% else %}{{ labels.uniqueUrls }}{% endif %}</span><span><b>{{ card.finding.counts.sourcePages }}</b> {{ labels.pages }}</span><span><b>{% if card.finding.counts.sourceRecords is not none %}{{ card.finding.counts.sourceRecords }}{% else %}{{ labels.unknown }}{% endif %}</b> {{ labels.records }}</span><span><b>{{ card.finding.counts.occurrences }}</b> {{ labels.occurrences }}</span></div>{% if card.finding.coverage != "measured" %}<p class="notice">{{ labels.incomplete }} · {{ labels.legacy }}</p>{% endif %}<div class="finding-prose"><div><h3>{{ labels.problem }}</h3><p>{{ card.presentation.explanation }}</p></div><div><h3>{{ labels.recommendation }}</h3><p>{{ card.presentation.recommendation }}</p></div><div><h3>{{ labels.verification }}</h3><p>{{ card.presentation.verification }}</p></div></div>{% if card.annotation %}<section class="ai-annotation"><h3>{{ labels.aiExplanation }}</h3><p>{{ card.annotation.explanation }}</p>{% if card.annotation.proposedCause %}<h4>{{ labels.proposedCause }}</h4><p>{{ card.annotation.proposedCause }}</p>{% endif %}<h4>{{ labels.recommendation }}</h4><p>{{ card.annotation.recommendation }}</p><h4>{{ labels.verification }}</h4><p>{{ card.annotation.verification }}</p><p class="muted">{{ labels.aiSamples }}: {{ card.annotation.sampleCount }} / {{ card.annotation.evidenceTotal }} · {{ labels.aiModel }}: {{ card.annotation.model }}</p><details><summary>{{ labels.aiReferences }}</summary><ul>{% for reference in card.annotation.evidenceIds %}<li>{{ reference }}</li>{% endfor %}</ul></details></section>{% endif %}<div class="actions"><a class="button" href="{{ card.firstPage }}">{{ labels.allEvidence }} <span aria-hidden="true">↗</span></a><a class="text-link" href="{{ card.csvFile }}" download>{{ labels.csv }}</a></div></div></details></article>{% else %}<p class="empty-state">{{ labels.noFindings }}</p>{% endfor %}</section>
<section class="coverage"><div class="section-heading"><h2>{{ labels.scope }}</h2><span>{{ summary.sourceRecords }} {{ labels.captured }}</span></div><p>{{ labels.limits }}</p><div class="table-scroll"><table><thead><tr><th>{{ labels.findings }}</th><th>{{ labels.status }}</th><th>{{ labels.eligible }}</th></tr></thead><tbody>{% for item in coverage %}<tr><td><strong>{{ item.ruleId }}</strong><p>{{ item.reason }}</p></td><td>{% if item.state == "measured" %}{{ labels.measured }}{% elif item.state == "incomplete" %}{{ labels.incomplete }}{% else %}{{ labels.notMeasured }}{% endif %}</td><td>{% if item.eligibleRecords is not none %}{{ item.eligibleRecords }}{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div><details class="metadata"><summary>{{ labels.metadata }}</summary><pre>{{ metadata }}</pre></details></section><footer>{{ labels.footer }}</footer></main></body></html>
{% elif section == "evidenceStart" %}
<nav class="navigation"><a href="index.html">← {{ labels.back }}</a><a href="{{ csvFile }}" download>{{ labels.csv }}</a></nav><header class="evidence-heading"><p class="eyebrow">{{ presentation.category }} · {{ presentation.team }}</p><h1>{{ presentation.title }}</h1><p class="lead" id="evidence-range">{{ first }}–{{ last }} {{ labels.of }} {{ finding.counts.occurrences }} {{ labels.occurrences }}</p>{% if finding.coverage != "measured" %}<p class="notice">{{ labels.incomplete }} · {{ labels.legacy }}</p>{% endif %}</header><nav class="pagination" aria-label="{{ labels.allEvidence }}">{% if previous %}<a class="button secondary" rel="prev" href="{{ previous }}">← {{ labels.previous }}</a>{% endif %}{% if next %}<a class="button" rel="next" href="{{ next }}">{{ labels.next }} →</a>{% endif %}</nav><label class="page-search">{{ labels.pageSearch }}<input id="page-search" type="search" aria-describedby="page-search-help"></label><p id="page-search-help" class="muted">{{ labels.pageSearchHelp }}</p><div class="table-scroll"><table class="evidence-table"><thead><tr><th>{{ labels.originalUrl }}</th><th>{{ labels.status }}</th><th>{{ labels.fullEvidence }}</th></tr></thead><tbody>
{% elif section == "evidenceRow" %}
<tr class="evidence-row"><td><span class="url">{{ row.originalUrl }}</span>{% if row.finalUrl %}<small>{{ labels.finalUrl }}</small><span class="url">{{ row.finalUrl }}</span>{% endif %}{% if row.targetUrl %}<small>{{ labels.target }}</small><span class="url">{{ row.targetUrl }}</span>{% endif %}</td><td>{% if row.observed.statusCode is not none %}{{ row.observed.statusCode }}{% else %}{{ labels.unknown }}{% endif %}</td><td><details><summary>{{ labels.fullEvidence }}</summary><pre>{{ payload }}</pre></details><small class="evidence-id">{{ row.id }}</small>{% if row.attribution == "urlOnly" %}<small>{{ labels.legacy }}</small>{% endif %}</td></tr>
{% elif section == "evidenceEnd" %}
</tbody></table></div><nav class="pagination" aria-label="{{ labels.allEvidence }}">{% if previous %}<a class="button secondary" rel="prev" href="{{ previous }}">← {{ labels.previous }}</a>{% endif %}<a class="button secondary" href="index.html">{{ labels.back }}</a>{% if next %}<a class="button" rel="next" href="{{ next }}">{{ labels.next }} →</a>{% endif %}</nav><footer>{{ labels.footer }}</footer></main></body></html>
{% endif %}
