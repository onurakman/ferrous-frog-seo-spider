{% if section == "header" %}
<!doctype html><html lang="{{ labels.language }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; script-src 'self'; base-uri 'none'; object-src 'none'"><title>{{ title }} · Ferrous Frog</title><link rel="stylesheet" href="report.css"><script src="report.js" defer></script></head><body><main><div class="brand"><span class="brand-mark" aria-hidden="true">F</span> FERROUS FROG <span class="brand-note">{{ labels.brandNote }}</span></div>
{% elif section == "index" %}
<header class="hero"><p class="eyebrow">{{ labels.eyebrow }}</p><h1>{{ summary.baseline.request.title }} → {{ summary.current.request.title }}</h1><p class="lead">{{ labels.lead }}</p><div class="meta"><span>{{ labels.baseline }}: <strong>{{ summary.baseline.request.id }}</strong></span><span>{{ labels.current }}: <strong>{{ summary.current.request.id }}</strong></span><span>{{ labels.status }}: <strong>{{ labels.ready }}</strong></span></div></header>
<section class="metrics"><div class="metric"><span>{{ labels.findings }}</span><strong>{{ summary.findingCount }}</strong></div><div class="metric"><span>{{ labels.evidenceRows }}</span><strong>{{ summary.evidenceRows }}</strong></div><div class="metric"><span>{{ labels.compatibilityNotes }}</span><strong>{{ summary.compatibilityReasons|length }}</strong></div></section>
{% if compatibilityReasons %}<section class="coverage"><h2>{{ labels.compatibilityNotes }}</h2>{% for reason in compatibilityReasons %}<p class="notice">{{ reason }}</p>{% endfor %}</section>{% endif %}
{% if overview %}<section class="overview ai-overview"><div><p class="eyebrow">{{ labels.aiOverview }}</p><h2>{{ labels.aiExplanation }}</h2></div><div><p>{{ overview.summary }}</p><h3>{{ labels.aiPriorities }}</h3><ol>{% for findingId in overview.prioritizedFindingIds %}{% for card in cards %}{% if card.finding.findingId == findingId %}<li><a href="#comparison-finding-{{ card.number }}">{{ card.display.title }}</a></li>{% endif %}{% endfor %}{% endfor %}</ol><h3>{{ labels.aiLimitations }}</h3><ul>{% for limitation in overview.limitations %}<li>{{ limitation }}</li>{% endfor %}</ul><p class="muted">{{ labels.aiCoverage }}: {{ overview.includedFindingCount }} / {{ overview.totalFindingCount }} · {{ labels.aiSamples }}: {{ overview.sampledEvidenceCount }}{% if overview.partialCoverage %} · {{ labels.aiPartial }}{% endif %} · {{ labels.aiModel }}: {{ overview.model }}</p></div></section>{% endif %}
{% if aiGenerationVersion %}<p class="notice">{{ labels.aiGeneration }}: {{ aiGenerationVersion }}</p>{% endif %}
{% if aiAnnotatedFindings or overview %}<p class="notice">{{ labels.aiDisclosure }} · {{ aiAnnotatedFindings }} / {{ summary.findingCount }}</p>{% endif %}
<section class="findings-section"><div class="section-heading"><h2>{{ labels.computedChanges }}</h2><span>{{ summary.findingCount }}</span></div>
{% for card in cards %}<article class="finding-card" id="comparison-finding-{{ card.number }}"><details open><summary><span class="finding-heading"><strong>{{ card.display.title }}</strong><small>{{ card.display.status }} · {{ card.display.countUnit }}</small></span></summary><div class="finding-body"><div class="counts"><span><b>{{ card.finding.added }}</b> {{ labels.added }}</span><span><b>{{ card.finding.persisting }}</b> {{ labels.persisting }}</span><span><b>{{ card.finding.resolved }}</b> {{ labels.resolved }}</span><span><b>{{ card.finding.notObserved }}</b> {{ labels.notObserved }}</span></div><p>{{ labels.notObservedWarning }}</p>{% for reason in card.display.compatibilityReasons %}<p class="notice">{{ reason }}</p>{% endfor %}{% if card.annotation %}<section class="ai-annotation"><h3>{{ labels.aiExplanation }}</h3><p>{{ card.annotation.explanation }}</p>{% if card.annotation.proposedCause %}<h4>{{ labels.proposedCause }}</h4><p>{{ card.annotation.proposedCause }}</p>{% endif %}<h4>{{ labels.recommendation }}</h4><p>{{ card.annotation.recommendation }}</p><h4>{{ labels.verification }}</h4><p>{{ card.annotation.verification }}</p><p class="muted">{{ labels.aiSamples }}: {{ card.annotation.sampleCount }} / {{ card.annotation.evidenceTotal }} · {{ labels.aiModel }}: {{ card.annotation.model }}</p><details><summary>{{ labels.aiReferences }}</summary><ul>{% for reference in card.annotation.evidenceIds %}<li>{{ reference }}</li>{% endfor %}</ul></details></section>{% endif %}<div class="actions">{% if card.htmlPage %}<a class="button" href="{{ card.htmlPage }}">{{ labels.viewEvidence }}</a>{% endif %}<a class="text-link" href="{{ card.csvFile }}" download>{{ labels.downloadCsv }}</a></div></div></details></article>{% endfor %}</section>
<details class="metadata"><summary>{{ labels.frozenMetadata }}</summary><pre>{{ metadata }}</pre></details><footer>{{ labels.footer }}</footer></main></body></html>
{% elif section == "evidenceStart" %}
<nav class="navigation"><a href="index.html">← {{ labels.overview }}</a><a href="{{ csvFile }}" download>{{ labels.downloadCsv }}</a></nav><header class="evidence-heading"><p class="eyebrow">{{ display.status }}</p><h1>{{ display.title }}</h1><p class="lead">{{ first }}–{{ last }} / {{ total }} {{ labels.comparisonEvidenceRows }}</p><p class="notice">{{ labels.notObservedWarning }}</p></header><nav class="pagination">{% if previous %}<a class="button secondary" rel="prev" href="{{ previous }}">← {{ labels.previous }}</a>{% endif %}{% if next %}<a class="button" rel="next" href="{{ next }}">{{ labels.next }} →</a>{% endif %}</nav><div class="table-scroll"><table class="evidence-table"><thead><tr><th>{{ labels.originalUrl }}</th><th>{{ labels.state }}</th><th>{{ labels.before }}</th><th>{{ labels.after }}</th><th>{{ labels.capturedRow }}</th></tr></thead><tbody>
{% elif section == "evidenceRow" %}
<tr class="evidence-row"><td><span class="url">{{ row.requestUrl }}</span><small>{{ labels.occurrence }} {{ row.occurrence }}</small></td><td><strong>{{ display.state }}</strong><small>{{ display.reason }}</small></td><td><pre>{{ baseline }}</pre></td><td><pre>{{ current }}</pre></td><td><details><summary>{{ labels.fullEvidence }}</summary><pre>{{ payload }}</pre></details></td></tr>
{% elif section == "evidenceEnd" %}
</tbody></table></div><nav class="pagination">{% if previous %}<a class="button secondary" rel="prev" href="{{ previous }}">← {{ labels.previous }}</a>{% endif %}<a class="button secondary" href="index.html">{{ labels.overview }}</a>{% if next %}<a class="button" rel="next" href="{{ next }}">{{ labels.next }} →</a>{% endif %}</nav><footer>{{ labels.footer }}</footer></main></body></html>
{% endif %}
